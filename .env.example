# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Le fichier .env est ignoré par git : tes clés ne partiront jamais sur GitHub.
# En production (GitHub Actions), ces valeurs sont des "Actions secrets".

# Clé API Anthropic (Console Claude → Settings → API keys). Commence par "sk-ant-".
ANTHROPIC_API_KEY=

# Envoi d'email via Gmail (phase 6) — mot de passe d'APPLICATION, pas ton mot de passe Gmail.
SMTP_USER=
SMTP_PASSWORD=
# Destinataire(s), séparés par des virgules.
EMAIL_TO=
